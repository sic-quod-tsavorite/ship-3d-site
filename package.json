{
  "name": "ship-3d-site",
  "private": true,
  "version": "1.4.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build-dev": "vue-tsc -b && vite build --mode moove",
    "build:static": "vue-tsc -b && vite build --mode static && rm -rf docs/assets/images docs/assets/logos docs/assets/models docs/.htaccess",
    "preview": "vite preview",
    "preview-dev": "rm -rf dist-preview && mkdir -p dist-preview/3d && cp -r dist/* dist-preview/3d/ && cp serve.json dist-preview/ && npx serve dist-preview",
    "lint": "eslint src --fix",
    "test": "vitest --ui"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "three": "^0.182.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^25.9.4",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "dat.gui": "^0.7.9",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.3",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
